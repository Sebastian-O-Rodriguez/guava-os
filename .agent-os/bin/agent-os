#!/usr/bin/env bash
# agent-os — Guava Agent OS CLI
# Thin wrapper that runs the TypeScript CLI via tsx.
# Usage: .agent-os/bin/agent-os <command> [flags]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

exec npx tsx "$REPO_ROOT/.agent-os/src/cli.ts" "$@"
