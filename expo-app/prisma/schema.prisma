// RoutineMe — Prisma Schema v2
// Single-user category/goal/log tracker. PostgreSQL backend.
//
// Design decisions:
//   PK strategy:  cuid() — URL-safe, native Prisma, no external deps.
//   Log data:     Json field storing typed payloads per category type.
//                 Validated in app code (Zod). Avoids join tables for a tiny dataset.
//   Indexes:      Optimised for today-view, progress queries, and date-range scans.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// User — single-user app, kept minimal. No auth fields.
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categories Category[]
  dailyNotes DailyNote[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Category — a tracking domain (e.g. Gym, Nutrition, Running, custom).
//
// type: "gym" | "nutrition" | "running" | "custom"
// icon/color: optional display metadata
// ---------------------------------------------------------------------------
model Category {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  type      String   @default("custom")
  icon      String?
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]
  logs  Log[]

  @@index([userId, active])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Goal — a quantitative target attached to a category.
//
// metric: e.g. "calories", "protein", "miles", "leg_sessions"
// target: numeric goal value
// period: "daily" | "weekly"
// ---------------------------------------------------------------------------
model Goal {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  metric     String
  target     Float
  period     String   @default("weekly")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, active])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Log — one entry per category per session/day.
//
// data stores a typed JSON payload depending on category type:
//   Gym:       { bodyPart: string, notes?: string }
//   Nutrition: { item: string, calories: number, protein: number, fat: number, carbs?: number }
//   Running:   { miles: number, duration?: string, notes?: string }
//   Custom:    { value: number, notes?: string }
// ---------------------------------------------------------------------------
model Log {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  date       DateTime @db.Date
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, date])
  @@index([date])
  @@map("logs")
}

// ---------------------------------------------------------------------------
// DailyNote — one optional reflection per day, tied to the user.
// Unique on (userId, date) — single user but keeps the constraint explicit.
// ---------------------------------------------------------------------------
model DailyNote {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  date       DateTime @db.Date
  reflection String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], map: "uq_daily_note_user_date")
  @@index([date], map: "idx_daily_note_date")
  @@map("daily_notes")
}
