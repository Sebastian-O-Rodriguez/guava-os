{
  "name": "pmlad",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "pnpm db:generate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:web": "pnpm --filter @pmlad/web2 dev",
    "dev:ui": "pnpm --filter @pmlad/ui dev",
    "dev:api": "pnpm --filter @pmlad/api dev",
    "build": "pnpm db:generate && turbo run build",
    "build:ui": "pnpm --filter @pmlad/ui build",
    "build:web2": "pnpm --filter @pmlad/web2 build",
    "dev": "turbo run dev --parallel --filter=@pmlad/ui --filter=@pmlad/web2",
    "e2e:tenants": "bash apps/api/scripts/e2e-tenants.sh",
    "e2e:properties": "bash apps/api/scripts/e2e-properties.sh",
    "e2e:all": "pnpm e2e:tenants && pnpm e2e:properties",
    "api:kill": "lsof -i :3001 -t | xargs -r kill || true",
    "db:generate": "pnpm --filter @pmlad/api exec prisma generate",
    "db:migrate:dev": "pnpm --filter @pmlad/api prisma migrate dev && pnpm db:generate",
    "db:validate": "pnpm --filter @pmlad/api run migrate:validate",
    "db:reset:dev": "pnpm -F @pmlad/api exec prisma migrate reset --force && pnpm -F @pmlad/api exec prisma db seed",
    "api:reseed": "pnpm api:kill && pnpm db:reset:dev && pnpm --filter @pmlad/api dev",
    "ci:openapi-export": "pnpm --filter @pmlad/api openapi:export",
    "ci:openapi-diff": "tsx scripts/openapi-diff.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.1",
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "reac": "^0.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  }
}
