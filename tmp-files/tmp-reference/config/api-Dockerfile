# ---- builder ----
FROM node:20-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm -r install --frozen-lockfile
# Generate Prisma client (outputs to packages/db/generated/client)
RUN pnpm db:generate
# Build workspace dependencies then API
RUN pnpm --filter @pmlad/types --filter @pmlad/utils --filter @pmlad/db build
RUN pnpm --filter @pmlad/api build

# ---- runner ----
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
ARG GIT_SHA=local
ENV GIT_SHA=$GIT_SHA
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install curl for healthcheck
RUN apk add --no-cache curl

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/packages ./packages

# Runtime files
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma

EXPOSE 3001

# Run migrations then start
CMD sh -c "cd apps/api && npx prisma migrate deploy && cd ../.. && pnpm --filter @pmlad/api start:prod"
