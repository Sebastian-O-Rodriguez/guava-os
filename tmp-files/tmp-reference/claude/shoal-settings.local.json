{
  "permissions": {
    "allow": [
      "Bash(uv run pytest -m \"not integration\" --co -q 2>&1 | tail -5)",
      "Bash(wc -l src/shoal/**/*.py src/shoal/**/**/*.py src/shoal/**/**/**/*.py 2>/dev/null | tail -1)",
      "Bash(uv run pytest -m \"not integration\" -q --tb=short -x 2>&1 | tail -5)",
      "Bash(uv run python -c \"import shoal; print\\(shoal.__version__\\)\")",
      "Bash(brew reinstall --build-from-source git 2>&1)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "shoal-orchestrator"
  ]
}
