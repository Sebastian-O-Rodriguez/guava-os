{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-report.schema.json",
  "title": "Execution Report",
  "description": "Output contract for agent execution sessions. Phase 2A spec — not yet consumed by runtime.",
  "type": "object",
  "required": [
    "issue_id",
    "persona",
    "status",
    "summary",
    "files_changed",
    "tests_run",
    "blockers",
    "recommended_transition",
    "correlation_id",
    "timestamp"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d+$",
      "description": "Linear issue ID"
    },
    "persona": {
      "type": "string",
      "enum": ["architect", "backend", "frontend", "qa"],
      "description": "Executing agent persona"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed", "abandoned"],
      "description": "Outcome of the execution session"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable description of what was done"
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths modified relative to repo root"
    },
    "tests_run": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Test file paths or suite names executed"
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Obstacles encountered during execution"
    },
    "recommended_transition": {
      "type": "string",
      "enum": ["in_progress", "in_review", "done", "blocked", "none"],
      "description": "Suggested Linear status transition (does not trigger mutation)"
    },
    "correlation_id": {
      "type": "string",
      "description": "Links to the directive that triggered this session"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report generation"
    }
  },
  "additionalProperties": false
}
