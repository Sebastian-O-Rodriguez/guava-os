#!/usr/bin/env bash
# guava-os — Guava Guava OS CLI
# Thin wrapper that runs the TypeScript CLI via tsx.
# Usage: .guava-os/bin/guava-os <command> [flags]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

exec npx tsx "$REPO_ROOT/.guava-os/src/cli.ts" "$@"
