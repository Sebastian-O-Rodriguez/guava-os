{
  "$schema": "./config.schema.json",
  "linear": {
    "team": "Guava AI",
    "project": "guava-os",
    "issue_prefix": "GUA"
  },
  "personas": [
    "architect",
    "backend",
    "frontend",
    "qa"
  ],
  "statuses": {
    "backlog": "Backlog",
    "todo": "Todo",
    "in_progress": "In Progress",
    "in_review": "In Review",
    "done": "Done"
  },
  "active_parent_statuses": [
    "Todo",
    "In Progress"
  ],
  "labels": {
    "persona_labels": [
      "architect",
      "backend",
      "frontend"
    ],
    "qa_label": "qa"
  },
  "invariants": {
    "max_todo_per_persona": 3,
    "stale_hours": 48,
    "reclaim_limit": 2,
    "bulk_threshold": 5,
    "max_subtasks_per_parent": 3
  },
  "branch_pattern": "feat/{prefix}-{id}-{slug}",
  "process_files": {},
  "manifest_path": ".guava-os/manifest.json"
}
